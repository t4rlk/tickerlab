# ─────────────────────────────────────────────────────────────────────────────
# Exemple de configuration des secrets — COPIER en .env (jamais commité).
#   cp .env.example .env   puis renseigner les valeurs.
#
# SÉCURITÉ : ce fichier ne contient QUE des noms de variables, jamais de valeur.
# Les clés LLM restent 100 % côté serveur — elles ne sont jamais transmises au
# client web. Révoquer immédiatement toute clé exposée publiquement.
# ─────────────────────────────────────────────────────────────────────────────

# Clé API du provider LLM par défaut (config.yaml : ai_writer.fournisseur=groq).
# Nécessaire uniquement si la sortie « Rapport rédigé » est demandée.
GROQ_API_KEY=

# Provider alternatif (si ai_writer.fournisseur=cerebras ou env_key=CEREBRAS_API_KEY).
CEREBRAS_API_KEY=

# Autres providers supportés (renseigner selon ai_writer.fournisseur) :
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
